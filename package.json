  "scripts": {
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "worker:build": "node esbuild.workers.mjs",
    "electron:build": "tsup",
    "electron:build:watch": "tsup --watch",
    "dev": "npm run worker:build && npm-run-all --parallel next:dev electron:dev",
    "build": "npm run worker:build && npm run next:build",
    "start": "npm run next:start",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "desktop:build": "npm run build && npm run prepare:standalone && npm run electron:build",
    "native:rebuild:node": "npm rebuild better-sqlite3",
    "native:rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "electron:dev": "npm-run-all --parallel electron:build:watch electron:start",
    "electron:start": "wait-on http://localhost:3000 && electron --remote-debugging-port=9222 build/main.js",
    "electron:package": "npm run desktop:build && electron-forge package",
    "electron:make": "npm run desktop:build && electron-forge make",
    "electron:dist": "npm run electron:make",
    "dist": "npm run electron:make",
    "lint": "biome check",
    "format": "biome format --write",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lan-server": "node scripts/lan-server.mjs"
  },
