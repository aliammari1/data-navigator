{
  "name": "data-navigator",
  "version": "1.0.1",
  "description": "AI-powered local data analysis and visualization platform",
  "author": "Ali Ammari <ammari.ali.0001@gmail.com>",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliammari1/data-navigator.git"
  },
  "homepage": "https://github.com/aliammari1/data-navigator#readme",
  "bugs": {
    "url": "https://github.com/aliammari1/data-navigator/issues"
  },
  "main": "build/main.js",
  "scripts": {
    "dev": "pnpm run worker:build && concurrently -k -n next,electron -c auto \"pnpm run next:dev\" \"pnpm run electron:dev\"",
    "dev:lan": "node scripts/lan-server.mjs",
    "next:dev": "next dev -H 0.0.0.0",
    "next:build": "next build",
    "next:start": "next start -H 0.0.0.0",
    "worker:build": "node esbuild.workers.mjs",
    "electron:dev": "concurrently -k -n electron-build,electron-start -c auto \"pnpm run electron:build:watch\" \"pnpm run electron:start:dev\"",
    "electron:start:dev": "wait-on http://127.0.0.1:3000 build/main.js && electron --ozone-platform-hint=auto --remote-debugging-port=9222 build/main.js",
    "electron:start:cov": "wait-on http://127.0.0.1:3000 build/main.js && NODE_V8_COVERAGE=.v8-coverage electron --ozone-platform-hint=auto --remote-debugging-port=9222 build/main.js",
    "electron:build": "tsup",
    "electron:build:watch": "tsup --watch",
    "build": "pnpm run worker:build && pnpm run next:build",
    "desktop:prepare": "node scripts/prepare-standalone.mjs",
    "desktop:build": "pnpm run build && pnpm run desktop:prepare && pnpm run electron:build",
    "models:prepare": "node scripts/prepare-models.mjs",
    "models:hash": "node scripts/compute-model-hashes.mjs",
    "package": "pnpm run desktop:build && electron-builder --config electron-builder.config.ts",
    "package:dir": "pnpm run desktop:build && electron-builder --config electron-builder.config.ts --dir",
    "package:linux": "pnpm run desktop:build && electron-builder --config electron-builder.config.ts --linux --x64 --publish never",
    "package:linux:dir": "pnpm run desktop:build && electron-builder --config electron-builder.config.ts --linux --x64 --dir",
    "package:win": "pnpm run desktop:build && electron-builder --config electron-builder.config.ts --win --x64 --publish never",
    "package:win:dir": "pnpm run desktop:build && electron-builder --config electron-builder.config.ts --win --x64 --dir",
    "package:publish": "pnpm run desktop:build && electron-builder --config electron-builder.config.ts --publish always",
    "start": "pnpm run next:start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:generate:chat": "drizzle-kit generate --config=drizzle.chat.config.ts",
    "db:generate:settings": "drizzle-kit generate --config=drizzle.settings.config.ts",
    "check:static": "pnpm run lint && pnpm run typecheck",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:deps": "depcruise src electron scripts .storybook --config .dependency-cruiser.js",
    "check:deadcode": "knip",
    "check:size": "size-limit",
    "check": "pnpm run check:deps && pnpm run check:static && pnpm run check:architecture && pnpm run check:deadcode",
    "deps:graph": "depcruise src electron scripts .storybook --config .dependency-cruiser.js --output-type mermaid",
    "verify": "pnpm run check && pnpm run test && pnpm run storybook:build",
    "verify:full": "pnpm run verify && pnpm run check:size",
    "verify:release": "pnpm run verify && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:eval": "vitest run --config vitest.eval.config.ts",
    "test:eval:live": "cross-env DN_EVAL_LIVE=1 vitest run --config vitest.eval.config.ts",
    "test:mutation": "stryker run",
    "test:smoke:collab": "node scripts/collab-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:electron": "playwright test --config=playwright.electron-e2e.config.ts",
    "test:visual": "playwright test --config=playwright.storybook.config.ts",
    "test:visual:update": "playwright test --config=playwright.storybook.config.ts --update-snapshots",
    "test:storybook": "test-storybook",
    "bench": "vitest bench --run",
    "bench:duckdb": "vitest bench --run --config vitest.duckdb-bench.config.ts",
    "bench:engines": "node scripts/bench-engines.mjs",
    "bench:electron": "playwright test --config=playwright.electron-perf.config.ts",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:check:figma": "node scripts/check-storybook-figma.mjs",
    "storybook:check:stories": "node scripts/check-stories.mjs",
    "storybook:check:stories:strict": "node scripts/check-stories.mjs --strict",
    "storybook:build": "pnpm run storybook:check:figma && pnpm run storybook:check:stories && storybook build",
    "storybook:test": "test-storybook",
    "storybook:test:ci": "concurrently -k -s first -n storybook,test -c magenta,blue \"pnpm exec http-server storybook-static --port 6006 --silent -c-1\" \"wait-on tcp:127.0.0.1:6006 && pnpm exec test-storybook --url http://127.0.0.1:6006\"",
    "audit:security": "pnpm audit --audit-level high --prod",
    "audit:security:full": "node scripts/security-audit.mjs",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:tag": "changeset tag",
    "release:publish": "node scripts/changeset-publish.mjs",
    "deps:rebuild:node": "pnpm rebuild better-sqlite3 better-sqlite3-multiple-ciphers",
    "deps:rebuild:electron": "electron-rebuild -f -w better-sqlite3,better-sqlite3-multiple-ciphers",
    "setup:hooks": "lefthook install",
    "prepare": "lefthook install"
  },
