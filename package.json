{
  "name": "data-navigator",
  "version": "0.1.0",
  "description": "AI-powered data analysis and visualization platform",
  "author": "Ali Ammari",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliammari1/data-navigator.git"
  },
  "homepage": "https://github.com/aliammari1/data-navigator#readme",
  "bugs": {
    "url": "https://github.com/aliammari1/data-navigator/issues"
  },
  "main": "build/main.js",
  "scripts": {
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "worker:build": "node esbuild.workers.mjs",
    "electron:build": "tsup",
    "electron:build:watch": "tsup --watch",
    "dev": "pnpm run worker:build && concurrently -k -n next,electron -c auto \"pnpm run next:dev\" \"pnpm run electron:dev\"",
    "build": "pnpm run worker:build && pnpm run next:build",
    "start": "pnpm run next:start",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "desktop:build": "pnpm run build && pnpm run prepare:standalone && pnpm run electron:build",
    "electron:dev": "concurrently -k -n electron-build,electron-start -c auto \"pnpm run electron:build:watch\" \"pnpm run electron:start\"",
    "electron:start": "wait-on http://localhost:3000 build/main.js && electron --remote-debugging-port=9222 build/main.js",
    "electron:dist": "pnpm run electron:make",
    "dist": "pnpm run electron:make",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:deps": "depcruise src electron scripts .storybook --config .dependency-cruiser.js",
    "deps:graph": "depcruise src electron scripts .storybook --config .dependency-cruiser.js --output-type mermaid",
    "check:providers": "node scripts/check-provider-boundaries.mjs",
    "quality": "pnpm run check:providers && pnpm run check:deps && pnpm run lint && pnpm run typecheck && pnpm run check:architecture && pnpm run test && pnpm run build:storybook",
    "verify": "pnpm run quality && pnpm run build",
    "lan-server": "node scripts/lan-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "check:storybook-figma": "node scripts/check-storybook-figma.mjs",
    "build:storybook": "pnpm run check:storybook-figma && storybook build",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "version:app": "changeset version && pnpm install --lockfile-only",
    "tag:app": "changeset tag",
    "electron:release": "pnpm run verify && pnpm run electron:publish",
    "prepare": "lefthook install",
    "analyze": "cross-env ANALYZE=true next build",
    "ci": "pnpm run check:providers && pnpm run check:deps && pnpm run lint && pnpm run typecheck && pnpm run check:architecture && pnpm run test && pnpm run build:storybook && pnpm run build",
    "ci:electron": "pnpm run electron:package",
    "ci:release": "pnpm run verify && pnpm run electron:publish",
    "electron:package": "pnpm run desktop:build && electron-forge package -- --platform=win32 --arch=x64",
    "electron:make": "pnpm run desktop:build && electron-forge make -- --platform=win32 --arch=x64",
    "electron:publish": "pnpm run desktop:build && electron-forge publish -- --platform=win32 --arch=x64",
    "voice:models": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-sherpa-models.ps1"
  },
