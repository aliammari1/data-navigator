{
  "name": "data-navigator",
  "version": "0.1.1",
  "description": "AI-powered local data analysis and visualization platform",
  "author": "Ali Ammari",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliammari1/data-navigator.git"
  },
  "homepage": "https://github.com/aliammari1/data-navigator#readme",
  "bugs": {
    "url": "https://github.com/aliammari1/data-navigator/issues"
  },
  "main": "build/main.js",
  "scripts": {
    "next:dev": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/next/dist/bin/next dev",
    "next:build": "next build",
    "next:start": "next start",
    "worker:build": "node esbuild.workers.mjs",
    "electron:build": "tsup",
    "electron:build:watch": "tsup --watch",
    "dev": "pnpm run worker:build && concurrently -k -n next,electron -c auto \"pnpm run next:dev\" \"pnpm run electron:dev\"",
    "build": "pnpm run worker:build && pnpm run next:build",
    "start": "pnpm run next:start",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "prepare:models": "node scripts/prepare-models.mjs",
    "models:hash": "node scripts/compute-model-hashes.mjs",
    "desktop:build": "pnpm run build && pnpm run prepare:standalone && pnpm run electron:build",
    "electron:dev": "concurrently -k -n electron-build,electron-start -c auto \"pnpm run electron:build:watch\" \"pnpm run electron:start\"",
    "electron:start": "wait-on http://localhost:3000 build/main.js && electron --remote-debugging-port=9222 build/main.js",
    "electron:dist": "pnpm run electron:make",
    "dist": "pnpm run electron:make",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:deps": "depcruise src electron scripts .storybook --config .dependency-cruiser.js",
    "deps:graph": "depcruise src electron scripts .storybook --config .dependency-cruiser.js --output-type mermaid",
    "check:deadcode": "knip",
    "audit:lhci": "lhci autorun",
    "quality": "pnpm run check:deps && pnpm run lint && pnpm run typecheck && pnpm run check:architecture && (pnpm run check:deadcode || true) && pnpm run test && pnpm run build:storybook",
    "quality:full": "pnpm run check:deps && pnpm run lint && pnpm run typecheck && pnpm run check:architecture && pnpm run check:deadcode && pnpm run test && pnpm run build:storybook && pnpm run size",
    "verify": "pnpm run quality && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:eval": "vitest run --config vitest.eval.config.ts",
    "test:eval:live": "cross-env DN_EVAL_LIVE=1 vitest run --config vitest.eval.config.ts",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:vr": "playwright test --config=playwright.storybook.config.ts",
    "test:vr:update": "playwright test --config=playwright.storybook.config.ts --update-snapshots",
    "bench": "vitest bench --run",
    "bench:duckdb": "vitest bench --run --config vitest.duckdb-bench.config.ts",
    "bench:engines": "node scripts/bench-engines.mjs",
    "bench:electron": "playwright test --config=playwright.electron-perf.config.ts",
    "test:storybook": "test-storybook",
    "test:storybook:ci": "concurrently -k -s first -n SB,TEST -c magenta,blue \"pnpm dlx http-server storybook-static --port 6006 --silent -c-1\" \"wait-on tcp:127.0.0.1:6006 && pnpm exec test-storybook --url http://127.0.0.1:6006\"",
    "size": "size-limit",
    "audit:security": "pnpm audit --audit-level high --prod",
    "storybook": "storybook dev -p 6006",
    "check:storybook-figma": "node scripts/check-storybook-figma.mjs",
    "check:stories": "node scripts/check-stories.mjs",
    "check:stories:strict": "node scripts/check-stories.mjs --strict",
    "build:storybook": "pnpm run check:storybook-figma && pnpm run check:stories && storybook build",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "version:app": "changeset version && pnpm install --lockfile-only",
    "tag:app": "changeset tag",
    "electron:release": "pnpm run verify && pnpm run electron:publish",
    "prepare": "lefthook install",
    "ci": "pnpm run check:deps && pnpm run lint && pnpm run typecheck && pnpm run check:architecture && pnpm run test && pnpm run build:storybook && pnpm run build",
    "ci:electron": "pnpm run electron:package",
    "ci:release": "pnpm run verify && pnpm run electron:publish",
    "electron:package": "pnpm run desktop:build && electron-forge package -- --platform=win32 --arch=x64",
    "electron:make": "pnpm run desktop:build && electron-forge make -- --platform=win32 --arch=x64",
    "electron:publish": "pnpm run desktop:build && electron-forge publish -- --platform=win32 --arch=x64",
    "rebuild:node": "pnpm rebuild better-sqlite3 better-sqlite3-multiple-ciphers",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3,better-sqlite3-multiple-ciphers"
  },
