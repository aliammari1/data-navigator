{
  "name": "data-navigator",
  "version": "0.1.0",
  "description": "AI-powered data analysis and visualization platform",
  "author": "Data Navigator Team",
  "private": true,
  "main": "dist-electron/main.js",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "build:worker": "bun build src/workers/python-sandbox.worker.ts --outfile public/workers/python-sandbox.worker.js --target browser --bundle && bun build src/workers/llm.worker.ts --outfile public/workers/llm.worker.js --target browser --bundle && bun build src/features/data-formulator/core/voice/voice-stt-worker.ts --outfile public/workers/voice-stt.worker.js --target browser --bundle && bun build src/features/data-formulator/core/voice/voice-command-router.ts --outfile public/workers/voice-router.worker.js --target browser --bundle",
    "build:electron": "bun build electron/main.ts --outfile=dist-electron/main.js --target=node --format=cjs --bundle --packages external && bun build electron/preload.ts --outfile=dist-electron/preload.js --target=node --format=cjs --bundle --packages external",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "dev": "bun run build:worker && next dev",
    "electron:dev": "bun run build:electron && concurrently \"next dev\" \"wait-on http://localhost:3000 && electron --remote-debugging-port=9222 dist-electron/main.js\"",
    "electron:dev:debug": "bun run build:electron && concurrently \"next dev --webpack\" \"wait-on http://localhost:3000 && electron --remote-debugging-port=9222 dist-electron/main.js\"",
    "build": "bun run build:worker && next build",
    "build:desktop": "bun run build && bun run prepare:standalone && bun run build:electron",
    "electron:package": "bun run build:desktop && electron-forge package",
    "electron:make": "bun run build:desktop && electron-forge make",
    "electron:build": "bun run electron:make",
    "dist": "bun run electron:make",
    "start": "next start",
    "lint": "biome check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format": "biome format --write",
    "lan-server": "node scripts/lan-server.mjs"
  },
