{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/public",
      "!!**/.next",
      "!!**/out",
      "!!**/dist",
      "!!**/build",
      "!!**/coverage",
      "!!**/.turbo",
      "!!**/.vercel",
      "!!**/.omx",
      "!!**/.sisyphus",
      "!!**/storybook-static",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!drizzle/meta",
      "!!**/*.lock",
      "!!pnpm-lock.yaml"
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "auto",
    "trailingNewline": true
  },

  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "recommended": true,

      "a11y": {
        "useSemanticElements": "off",
        "useFocusableInteractive": "off",
        "noLabelWithoutControl": "off",
        "noSvgWithoutTitle": "off"
      },

      "security": {
        "noDangerouslySetInnerHtml": "off"
      },

      "suspicious": {
        "noArrayIndexKey": "off",
        "noControlCharactersInRegex": "off"
      },

      "style": {
        "noDefaultExport": "off",
        "useNamingConvention": "off",
        "useImportType": "off"
      },

      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "warn"
      }
    }
  },

  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },

  "javascript": {
    "jsxRuntime": "transparent",
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },

  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },

  "css": {
    "parser": {
      "tailwindDirectives": true,
      "cssModules": true
    }
  },

  "overrides": [
    {
      "includes": ["src/components/ui/**", "components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "noLabelWithoutControl": "off",
            "noSvgWithoutTitle": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "*.mjs", "*.cjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off",
            "noControlCharactersInRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": [".storybook/**", "storybook/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "warn",
            "noUnusedVariables": "warn"
          }
        }
      }
    }
  ]
}
