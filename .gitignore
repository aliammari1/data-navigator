# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local-first app staging & agent workspace (large; not committed)
.agy
.app-stage

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# mutation testing (Stryker)
/.stryker-tmp
/reports/mutation

# next.js
/.next/
/out/


# misc
.DS_Store
*.pem
.data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.storybook.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.agents
.claude
.kiro
dist
*.js.map
.codex
pfe-*/
BACKLOG.md

storybook-static/
.claude-flow
.swarm
.superpowers
.tmp-landing
.sisyphus
playwright-report

# Build-time model staging (scripts/prepare-models.mjs) — large GGUF weights.
.model-cache/

# Offline AI assets staged at setup-time (large; not committed). Run
# `pnpm stage:offline-assets` once (online) before packaging an offline build:
#   - Pyodide runtime + scientific wheels  (scripts/stage-pyodide.mjs)
#   - transformers.js weights e.g. MiniLM   (scripts/prepare-models.mjs)
/public/pyodide/
/public/models/transformers/

# Electron packaging staging (scripts/stage-app.mjs). electron-app/ is the staged
# Next standalone (remapped to app/ inside the package); app/ is a legacy staging
# name kept ignored so a stale one can never poison `next build` or be committed.
# build/node_modules/ is the staged Electron-main native-dep tree (build/*.js stay
# tracked, but the staged node_modules is a regenerated artifact).
/electron-app/
/app/
/build/node_modules/
.direnv/
