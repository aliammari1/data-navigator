{
  "extends": [
    "@tsconfig/next/tsconfig.json"
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "target": "ES2020",       // keep — bases don't set one
    "jsx": "react-jsx",       // keep, or switch to "preserve" to match Next's own default — functionally equivalent here since noEmit is on
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "electron/**/*.ts"
  ],
  "exclude": ["node_modules", "out", "dist", "tests"]
}
