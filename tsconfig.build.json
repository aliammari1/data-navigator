{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    // Production build gate for `next build` (wired via
    // `typescript.tsconfigPath` in next.config.ts). Per the Next.js docs, the
    // editor config (tsconfig.json) stays strict for incremental hardening
    // while the build enforces the recommended `strict: true` baseline.
    // The @tsconfig/strictest-only extras below are stylistic at build time
    // (~700 index-signature / unchecked-index / exact-optional errors across
    // the tree) and unused locals/params are a lint concern (biome), not a
    // ship-blocker. noImplicitReturns / noImplicitOverride stay ON: they
    // caught real bugs (missing effect cleanups, a missing `override`).
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  // Shipped Next.js application code only. electron/, evals/, tests/,
  // scripts/, electron-builder/playwright configs, and .storybook run under their own
  // toolchains (tsup, vitest, playwright, storybook) and must not gate
  // `next build` — see the note in next.config.ts.
  // Exception: electron/preload.ts holds the `declare global` Window bridge
  // augmentations (window.electronFS, window.electronLlama, …) the renderer
  // relies on, so it is part of the build program.
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "electron/preload.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.test.*", "**/*.spec.*", "**/*.stories.*", "**/*.bench.*"]
}
